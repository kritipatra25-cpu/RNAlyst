# RNAlyst Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual API credentials.
# NEVER commit your real .env file or API keys to version control.

# Active LLM Provider: 'groq' or 'gemini'
LLM_PROVIDER=groq

# Groq API Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
